{
  "name": "little-forge",
  "private": true,
  "displayName": "Little Forge",
  "description": "A TrueForge-native coding agent with budgeted repository context and reviewed, undoable edits.",
  "version": "0.1.2",
  "publisher": "priyanshu-chaurasia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyanshu-1006/Little-Forge.git"
  },
  "homepage": "https://github.com/priyanshu-1006/Little-Forge#readme",
  "bugs": {
    "url": "https://github.com/priyanshu-1006/Little-Forge/issues"
  },
  "keywords": [
    "trueforge",
    "ai-agent",
    "code-review",
    "mcp",
    "vscode"
  ],
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onView:littleForge.agent",
    "onCommand:littleForge.inlineEdit",
    "onCommand:littleForge.open",
    "onCommand:littleForge.stop",
    "onCommand:littleForge.undo",
    "onCommand:littleForge.setup",
    "onCommand:littleForge.review",
    "onCommand:littleForge.selfCheck",
    "onCommand:littleForge.newChat",
    "onCommand:littleForge.repro",
    "onCommand:littleForge.quickPlan",
    "onCommand:littleForge.quickTest",
    "onCommand:littleForge.isolated",
    "onCommand:littleForge.exportEvidence",
    "onCommand:littleForge.draftPullRequest",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Applying edits and running project commands require a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && vsce package --no-dependencies --no-rewrite-relative-links",
    "harness": "node scripts/start-harness.mjs",
    "spike": "tsx scripts/spike.ts",
    "test:ui": "npm run build && node scripts/ui-smoke.mjs",
    "evaluate:retrieval": "tsx scripts/evaluate-retrieval.ts",
    "accept:live": "tsx scripts/live-acceptance.ts",
    "accept:prepare": "node scripts/prepare-live.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "littleForge.open",
        "title": "Little Forge: Open Agent"
      },
      {
        "command": "littleForge.inlineEdit",
        "title": "Little Forge: Edit Selection"
      },
      {
        "command": "littleForge.stop",
        "title": "Little Forge: Stop Current Run"
      },
      {
        "command": "littleForge.undo",
        "title": "Little Forge: Undo Accepted Changes"
      },
      {
        "command": "littleForge.setup",
        "title": "Little Forge: Choose Provider and Model"
      },
      {
        "command": "littleForge.review",
        "title": "Little Forge: Review Proposed Changes"
      },
      {
        "command": "littleForge.selfCheck",
        "title": "Little Forge: Run Environment Pre-Flight Check"
      },
      {
        "command": "littleForge.decideHunk",
        "title": "Little Forge: Decide Proposed Hunk"
      },
      {
        "command": "littleForge.newChat",
        "title": "Little Forge: New Conversation"
      },
      {
        "command": "littleForge.repro",
        "title": "Little Forge: Repro-to-Regression"
      },
      {
        "command": "littleForge.quickPlan",
        "title": "Little Forge: Plan Implementation"
      },
      {
        "command": "littleForge.quickTest",
        "title": "Little Forge: Run Project Tests"
      },
      {
        "command": "littleForge.isolated",
        "title": "Little Forge: Open Isolated Git Worktree"
      },
      {
        "command": "littleForge.exportEvidence",
        "title": "Little Forge: Export ForgeProof Receipt"
      },
      {
        "command": "littleForge.draftPullRequest",
        "title": "Little Forge: Prepare Local Draft Pull Request"
      }
    ],
    "keybindings": [
      {
        "command": "littleForge.inlineEdit",
        "key": "ctrl+i",
        "win": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "littleForge.inlineEdit",
        "key": "alt+i",
        "win": "alt+i",
        "mac": "alt+i",
        "when": "editorTextFocus"
      },
      {
        "command": "littleForge.inlineEdit",
        "key": "ctrl+alt+i",
        "win": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus"
      },
      {
        "command": "littleForge.open",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "littleForge.newChat",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "littleForge.repro",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "littleForge",
          "title": "Little Forge",
          "icon": "resources/forge.svg"
        }
      ]
    },
    "views": {
      "littleForge": [
        {
          "id": "littleForge.agent",
          "name": "Forge Agent",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "littleForge.inlineEdit",
          "when": "editorTextFocus",
          "group": "littleForge@1"
        }
      ]
    },
    "configuration": {
      "title": "Little Forge",
      "properties": {
        "littleForge.notifyWhenHidden": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Notify when a hidden Little Forge sidebar needs review or recovery."
        },
        "littleForge.appearance": {
          "type": "string",
          "enum": ["system", "graphite", "blueprint", "paper", "moss", "violet", "glacier", "ember", "plum"],
          "default": "system",
          "scope": "application",
          "description": "Color theme for the Little Forge sidebar."
        },
        "littleForge.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8790",
          "scope": "application",
          "description": "Local TrueForge server origin."
        },
        "littleForge.model": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Configured TrueForge provider/model identifier; no model credentials are stored here."
        },
        "littleForge.fallbackModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional second configured TrueForge model for safe pre-mutation fallback."
        },
        "littleForge.reasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high"
          ],
          "default": "",
          "scope": "application",
          "description": "Optional reasoning level passed through TrueForge. Empty uses the provider default. Select only a level supported by both the primary and fallback models."
        },
        "littleForge.contextTokens": {
          "type": "number",
          "minimum": 8192,
          "maximum": 1000000,
          "default": 32768,
          "scope": "application",
          "description": "Verified model context capacity, including output reserve."
        },
        "littleForge.permissionMode": {
          "type": "string",
          "enum": [
            "review",
            "default",
            "auto",
            "turbo"
          ],
          "default": "review",
          "scope": "application",
          "description": "Every source change requires hunk review. Auto and Turbo can approve supported project checks."
        }
      }
    }
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@modelcontextprotocol/sdk": "1.26.0",
    "diff": "8.0.2",
    "highlight.js": "11.11.1",
    "ignore": "7.0.5",
    "markdown-it": "14.3.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@truefoundry/trueforge": "0.180.1",
    "@types/node": "22.18.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.12",
    "playwright-core": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
