# Normalise line endings: store LF in the repository and check out LF everywhere.
# This overrides any system-wide core.autocrlf setting and matches .editorconfig.
* text=auto eol=lf

# The Windows launcher is executed by cmd.exe and needs CRLF line endings.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be line-ending translated.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.vsix binary
*.zip binary
*.gz binary
*.tgz binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
